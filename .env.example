# Copy to .env and fill in. .env is ignored by git.
REPLAY_URL=http://localhost:8001          # the replay tool (talks to the chatbot)
CALENDAR_TEST_URL=http://localhost:7007   # the TEST calendar only; the driver refuses any other address
ANTHROPIC_API_KEY=                        # needed for the agent (the model is chosen in the UI)
BOT_BUDGET_USD=5                           # total spend allowed for the agent, across all runs (kill switch)
